{
  "name": "competition-backend",
  "version": "1.0.0",
  "description": "Competition Module Backend API",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "dev:standalone": "node src/devReplSetServer.js",
